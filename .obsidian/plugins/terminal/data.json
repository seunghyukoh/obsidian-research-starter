{
  "addToCommand": true,
  "addToContextMenu": true,
  "focusOnNewInstance": true,
  "newInstanceBehavior": "newHorizontalSplit",
  "interceptKeysWhenFocused": true,
  "defaultProfile": null,
  "profiles": {
    "darwinIntegratedDefault": {
      "name": "macOS - zsh (login)",
      "type": "integrated",
      "platforms": {
        "darwin": true
      },
      "executable": "/bin/zsh",
      "args": [
        "--login"
      ],
      "environment": [],
      "pythonExecutable": "python3",
      "restoreHistory": false,
      "followTheme": true,
      "rightClickAction": "copyPaste",
      "successExitCodes": [
        "0",
        "SIGINT",
        "SIGTERM"
      ],
      "terminalOptions": {
        "documentOverride": null
      },
      "useWin32Conhost": true
    },
    "linuxIntegratedDefault": {
      "name": "Linux - bash (login)",
      "type": "integrated",
      "platforms": {
        "linux": true
      },
      "executable": "/bin/bash",
